{
    "name": "infocyph/otp",
    "description": "Standalone OTP and MFA primitives for PHP.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "otp",
        "hotp",
        "totp",
        "aotp",
        "grid-otp",
        "passkey",
        "webauthn",
        "mobile-otp",
        "hmac",
        "sha",
        "ocra",
        "rfc4226",
        "rfc6238",
        "rfc6287",
        "sms-otp",
        "email-otp"
    ],
    "authors": [
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "php-64bit": "^8.4",
        "ext-ctype": "*",
        "bacon/bacon-qr-code": "^3.1.1",
        "infocyph/cachelayer": "^4.0.2",
        "paragonie/constant_time_encoding": "^3.1.3"
    },
    "require-dev": {
        "ext-sodium": "*",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "^3.0",
        "web-auth/webauthn-lib": "^5.3.10"
    },
    "conflict": {
        "spomky-labs/pki-framework": "<1.3.0",
        "symfony/clock": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/polyfill-php83": "<1.30.0",
        "symfony/property-access": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/property-info": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/serializer": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/uid": "<6.4.3 || >=7.0 <7.0.3"
    },
    "suggest": {
        "ext-sodium": "Required to use the optional AOTP Ed25519 integration.",
        "infocyph/runwire": "Optional cooperative cancellation, deadlines, and lock waiting for stateful OTP operations.",
        "web-auth/webauthn-lib": "Required to use the optional Passkey/WebAuthn integration."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\OTP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\OTP\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "benchmark": "@php vendor/bin/phpbench run benchmarks --config=vendor/infocyph/phpforge/resources/phpbench.json --bootstrap=vendor/autoload.php --report=aggregate --output=json --progress=none",
        "benchmark:ci": [
            "@benchmark",
            "@benchmark:release"
        ],
        "benchmark:release": "@php benchmarks/release-gate.php --autoload=vendor/autoload.php --output=build/benchmark-result.json --release=working-tree"
    }
}
